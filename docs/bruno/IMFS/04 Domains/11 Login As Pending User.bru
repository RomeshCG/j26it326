meta {
  name: 11 Login As Pending User
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{pendingUserEmail}}",
    "password": "{{pendingUserPassword}}"
  }
}

docs {
  # Login As Pending User
  Attempts to log in with a user whose account is pending admin approval. Must return 403 Forbidden with a clear approval message.
}
