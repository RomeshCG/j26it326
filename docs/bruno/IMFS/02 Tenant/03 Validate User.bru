meta {
  name: 03 Validate User
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/tenant/users/{{testUserId}}/validate
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

docs {
  # Validate User
  Checks if testUserId exists, is active, and belongs to caller's institution. Returns { valid: boolean } only.
}
