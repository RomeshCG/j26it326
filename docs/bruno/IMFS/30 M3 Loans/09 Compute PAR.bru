headers {
  Content-Type: application/json
}

docs {
  # Compute Portfolio at Risk (PAR)
  Calculates days past due across all active loans and updates `par_status` rows and returns aggregate portfolio metrics (PAR1, PAR30, PAR90, PAR30 ratio).
}
