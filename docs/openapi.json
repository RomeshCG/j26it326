{
  "openapi": "3.0.3",
  "info": {
    "title": "IMFS M4 Core & Tenant API",
    "description": "Multi-tenant ERP backend API for Sri Lankan Microfinance Institutions (IMFS Component 4: Agentic ERP & Graduated Trust Architecture). Provides JWT authentication, RBAC, tenant routing, and core tenant query contracts for M1, M2, and M3.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:4000",
      "description": "Local development server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "HS256 signed JWT access token. Payload claims: userId (UUID), institutionId (UUID), role (one of: admin, executive, finance_officer, hr_officer, branch_manager, loan_officer). Header format: 'Authorization: Bearer <token>'"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Missing or invalid Authorization header"
          }
        },
        "required": [
          "error"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "admin@apex.lk"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "YourSecretPassword123!"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Short-lived JWT access token (HS256)",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          },
          "expiresIn": {
            "type": "string",
            "example": "15m"
          },
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "email": {
                "type": "string"
              },
              "fullName": {
                "type": "string"
              },
              "role": {
                "type": "string",
                "enum": [
                  "admin",
                  "executive",
                  "finance_officer",
                  "hr_officer",
                  "branch_manager",
                  "loan_officer"
                ]
              },
              "institutionId": {
                "type": "string",
                "format": "uuid"
              },
              "institutionName": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "email",
              "fullName",
              "role",
              "institutionId",
              "institutionName"
            ]
          }
        },
        "required": [
          "token",
          "expiresIn",
          "user"
        ]
      },
      "MeResponse": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "institutionId": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "executive",
              "finance_officer",
              "hr_officer",
              "branch_manager",
              "loan_officer"
            ]
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Permissions map for UI and application enforcement"
          }
        },
        "required": [
          "userId",
          "email",
          "fullName",
          "institutionId",
          "role",
          "capabilities"
        ]
      },
      "TenantInfoResponse": {
        "type": "object",
        "properties": {
          "institutionId": {
            "type": "string",
            "format": "uuid"
          },
          "institutionName": {
            "type": "string"
          },
          "databaseIdentifier": {
            "type": "string"
          },
          "info": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "institutionId": {
                "type": "string"
              },
              "institutionName": {
                "type": "string"
              },
              "createdAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        "required": [
          "institutionId",
          "institutionName",
          "databaseIdentifier"
        ]
      },
      "Branch": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "location": {
            "type": "string",
            "nullable": true
          },
          "district": {
            "type": "string",
            "nullable": true
          },
          "isActive": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "isActive",
          "createdAt"
        ]
      },
      "BranchesResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Branch"
            }
          },
          "count": {
            "type": "integer"
          }
        },
        "required": [
          "data",
          "count"
        ]
      },
      "ValidateUserResponse": {
        "type": "object",
        "properties": {
          "valid": {
            "type": "boolean",
            "description": "Strict boolean indicating whether the userId exists, is active, and belongs to caller's institution."
          }
        },
        "required": [
          "valid"
        ]
      },
      "VerifyDomainRequest": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "64-character hex verification token sent to mailbox"
          }
        },
        "required": [
          "token"
        ]
      },
      "VerifyDomainResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "institutionId": {
            "type": "string",
            "format": "uuid"
          },
          "verifiedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "message",
          "domain",
          "institutionId",
          "verifiedAt"
        ]
      },
      "SignupRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 8
          },
          "fullName": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password",
          "fullName"
        ]
      },
      "SignupResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "message",
          "email"
        ]
      },
      "RegisterDomainRequest": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "example": "apex.lk"
          },
          "verificationMailbox": {
            "type": "string",
            "example": "admin"
          },
          "defaultRoleId": {
            "type": "integer",
            "example": 6
          }
        },
        "required": [
          "domain",
          "verificationMailbox",
          "defaultRoleId"
        ]
      },
      "InstitutionDomain": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "institutionId": {
            "type": "string",
            "format": "uuid"
          },
          "domain": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "verified",
              "revoked"
            ]
          },
          "verificationExpiresAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "verifiedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "verifiedByUserId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "defaultRoleId": {
            "type": "integer"
          },
          "defaultRole": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              }
            }
          },
          "autoApprove": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "institutionId",
          "domain",
          "status",
          "defaultRoleId",
          "autoApprove",
          "createdAt",
          "updatedAt"
        ]
      },
      "PendingUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "role": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "id",
          "email",
          "fullName",
          "createdAt",
          "role"
        ]
      },
      "ApprovePendingUserRequest": {
        "type": "object",
        "properties": {
          "roleId": {
            "type": "integer",
            "description": "Optional custom non-admin role id to assign upon approval"
          }
        }
      },
      "RegisterInstitutionRequest": {
        "type": "object",
        "properties": {
          "institutionName": {
            "type": "string",
            "example": "Apex Microfinance Ltd",
            "minLength": 3,
            "maxLength": 100
          },
          "licenseNumber": {
            "type": "string",
            "example": "MFI-LK-001",
            "nullable": true
          },
          "adminFullName": {
            "type": "string",
            "example": "Anura Perera",
            "minLength": 2,
            "maxLength": 100
          },
          "adminEmail": {
            "type": "string",
            "format": "email",
            "example": "admin@apex.lk"
          },
          "adminPassword": {
            "type": "string",
            "format": "password",
            "example": "SecurePassword123!"
          },
          "institutionType": {
            "type": "string",
            "enum": [
              "licensed_finance_company",
              "microfinance_ngo",
              "rural_development_bank",
              "cooperative_society"
            ],
            "default": "microfinance_ngo"
          },
          "district": {
            "type": "string",
            "example": "Colombo",
            "nullable": true
          },
          "planName": {
            "type": "string",
            "enum": [
              "Starter",
              "Standard",
              "Professional",
              "Enterprise"
            ],
            "default": "Starter"
          },
          "billingCycle": {
            "type": "string",
            "enum": [
              "monthly",
              "annual"
            ],
            "default": "monthly"
          }
        },
        "required": [
          "institutionName",
          "adminFullName",
          "adminEmail",
          "adminPassword"
        ]
      },
      "RegisterInstitutionResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Institution registered and provisioned successfully"
          },
          "institution": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "name": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "example": "active"
              }
            },
            "required": [
              "id",
              "name",
              "status"
            ]
          },
          "admin": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "email": {
                "type": "string"
              },
              "fullName": {
                "type": "string"
              },
              "role": {
                "type": "string",
                "example": "admin"
              }
            },
            "required": [
              "id",
              "email",
              "fullName",
              "role"
            ]
          }
        },
        "required": [
          "message",
          "institution",
          "admin"
        ]
      }
    }
  },
  "paths": {
    "/auth/login": {
      "post": {
        "summary": "User authentication",
        "description": "Authenticates a user by email and bcrypt password. Validates against central.users and requires user status 'active'. Returns a 15-minute JWT access token. Logs attempts to central.login_audit.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "Missing email or password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials or account disabled (uniform error prevents user enumeration)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Account pending approval or institution is not active",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests or temporary account lockout. Includes Retry-After header with backoff duration in seconds.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Number of seconds to wait before retrying"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/register-institution": {
      "post": {
        "summary": "Register and provision new institution",
        "description": "Public onboarding endpoint to provision an isolated tenant database, bootstrap organization metadata and activate sole initial administrator. Protected by abuse gate and pre-hijack domain checks.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterInstitutionRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Institution registered and provisioned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterInstitutionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error or registration request conflict (timing-parity protected)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Public registration disabled or invalid setup key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded. Includes Retry-After header with cooldown duration in seconds.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Number of seconds to wait before retrying"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service temporarily busy (concurrency limit reached)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "summary": "Current user profile & capabilities",
        "description": "Returns current user details, role, and permissions map. Allowed roles: all 6 authenticated roles.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authenticated user profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, or expired Bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Institution is not active",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/tenant/info": {
      "get": {
        "summary": "Get current tenant metadata",
        "description": "Returns cached tenant_info from caller's dedicated tenant database. Allowed roles: all 6 authenticated roles.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Tenant metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantInfoResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/tenant/branches": {
      "get": {
        "summary": "List active branches",
        "description": "Returns active branch records for the caller's tenant institution. Allowed roles: all 6 authenticated roles.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "List of active branches",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BranchesResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/tenant/users/{userId}/validate": {
      "get": {
        "summary": "Validate soft user_id reference",
        "description": "Verifies whether a user_id exists in central.users, has active status, and belongs to caller's institution. Returns strictly { valid: boolean } with no other user details to prevent enumeration. Allowed roles: all 6 authenticated roles.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "description": "UUID of the user to validate",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Validation result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidateUserResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/domains/verify": {
      "post": {
        "summary": "Verify claimed institution domain",
        "description": "Public endpoint to confirm domain ownership using a 64-character hex token sent to the verification mailbox. Updates domain status to verified.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyDomainRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Domain successfully verified",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyDomainResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid, expired, or already used verification token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Domain has already been claimed and verified by another institution",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded. Includes Retry-After header with cooldown duration in seconds.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Number of seconds to wait before retrying"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/signup": {
      "post": {
        "summary": "Self-service staff registration",
        "description": "Public endpoint for staff to register under an institution with a verified email domain. User is created in pending status awaiting administrator approval. Timing-parity protected.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Registration received, awaiting administrator approval",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignupResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error or unverified/blocked domain",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded. Includes Retry-After header with cooldown duration in seconds.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Number of seconds to wait before retrying"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
