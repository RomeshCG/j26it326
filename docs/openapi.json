    "/api/tenant/domains/{domainId}/resend": {
      "post": {
        "summary": "Resend domain verification email",
        "description": "Generates a new verification token and resends verification email to the specified mailbox for a pending domain. Admin only.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "domainId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "verificationMailbox": {
                    "type": "string",
                    "example": "admin",
                    "description": "Local-part of mailbox on the claimed domain (^[a-z0-9._-]{1,64}$)"
                  }
                },
                "required": [
                  "verificationMailbox"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verification email resent",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "expiresAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "message",
                    "expiresAt"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Missing/invalid verificationMailbox or domain is not pending verification"
          },
          "404": {
            "description": "Domain not found"
          },
          "429": {
            "description": "Admin mutating rate limit exceeded (max 30 requests per 15 min per institution). Includes Retry-After header.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Number of seconds to wait before retrying"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/tenant/domains/{domainId}": {
      "delete": {
        "summary": "Revoke institution domain",
        "description": "Revokes a domain. If the domain was verified, disables all active and pending users on that domain in a single transaction (blocked if it would remove caller's institution's last active admin). If the domain was pending, marks it revoked, clears the verification token, and disables no users (deactivatedUsersCount: 0). Admin only.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "domainId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Domain revoked and associated users disabled",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "domain": {
                      "type": "string"
                    },
                    "disabledUsersCount": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "message",
                    "domain",
                    "disabledUsersCount"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Domain not found"
          },
          "409": {
            "description": "Cannot revoke domain: would disable the last active administrator"
          },
          "429": {
            "description": "Admin mutating rate limit exceeded (max 30 requests per 15 min per institution). Includes Retry-After header.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Number of seconds to wait before retrying"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
