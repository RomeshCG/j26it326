*.pyc
*.pyo
.pytest_cache/
.ipynb_checkpoints/

# ML datasets & model artifacts (keep CODE in git, not generated data)
# Synthetic / customer-demo datasets must stay local — do not push
ml/**/data/raw/
ml/**/data/synthetic/
ml/**/data/private/
ml/**/data/processed/
ml/**/data/features/
ml/**/data/scores/
