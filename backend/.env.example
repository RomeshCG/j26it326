PORT=4000
# Deployments must set NODE_ENV=production (console email service only fails closed when NODE_ENV is exactly production)
NODE_ENV=development

# Central Neon database (institutions, users, routing)
CENTRAL_DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Default / demo tenant Neon database (business data for one MFI)
# Additional tenants are resolved at runtime via central.institution_databases
TENANT_DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Optional: used by seed scripts
DEMO_INSTITUTION_NAME="Apex Microfinance Ltd"
DEMO_INSTITUTION_LICENSE="MFI-DEMO-001"

# M3 — cross-module service URLs (leave unset to use stubs during local dev)
M1_SERVICE_URL=                # e.g. http://localhost:5001  — M1 risk scoring service
M2_SERVICE_URL=                # e.g. http://localhost:5002  — M2 ledger event webhook
M3_ML_SERVICE_URL=             # e.g. http://localhost:8000  — M3 EWS Python ML service

# JWT Authentication (HS256)
# Minimum 32 characters, never use default/placeholder in real environments
JWT_SECRET="replace-with-a-secure-random-secret-at-least-32-chars-long"
# University research / local development: long-lived access tokens (no refresh flow).
# Production deployments should use a short TTL (e.g. 15m). Code fallback remains 15m if unset.
JWT_EXPIRES_IN="7d"

# Internal agent runtime → Node dispatch (Phase 10). Required for POST /api/internal/agent-actions/dispatch.
# Minimum 32 characters; never commit a real value. Route returns 503 until a real key is set in local .env.
AGENT_SERVICE_KEY="replace-with-a-secure-random-secret-at-least-32-chars-long"

# A4 NLQ — private Ollama (homelab / Tailscale). Leave unset to fail closed (503).
# Do not commit real host addresses or credentials. Example: http://100.x.x.x:11434
# OLLAMA_BASE_URL=
# OLLAMA_MODEL=qwen2.5:1.5b
# Chat timeout in ms (integer 1000–120000). Default 30000 covers cold model load.
# OLLAMA_TIMEOUT_MS=30000


# Tenant Routing & Pool configuration (optional, defaults shown)
# TENANT_DB_CONNECTION_LIMIT=5
# MAX_TENANT_CLIENTS=10
# ROUTING_CACHE_TTL_SECONDS=60
# USER_AUTH_CACHE_TTL_MS=5000
# ENABLE_SWAGGER_DOCS=false # In production: true enables /docs and /openapi.json (default is on in development)

# Frontend client base URL (for email verification links)
FRONTEND_URL="http://localhost:5173"

# Tenant Provisioning (Phase 6)
ENABLE_PUBLIC_TENANT_REGISTRATION=false
# REGISTRATION_SETUP_KEY="replace-with-secure-key-required-in-production"
# MAX_CONCURRENT_PROVISIONING=2

# Security Hardening A: Trust Proxy & Client IP
# In development: leave false (reads direct socket IP)
# In production on Railway / Render / Fly (behind 1 reverse proxy): set hop count to 1
# WARNING: Setting to 'true' trusts any X-Forwarded-For header and must NOT be used if directly reachable
TRUST_PROXY=false

# Security Hardening A: Rate Limiting & Account Lockout
# Ignored in production (rate limiting is always enforced when NODE_ENV=production)
# ENABLE_RATE_LIMITING=true
# RATE_LIMIT_MAX_ENTRIES=10000
# RATE_LIMIT_LOGIN_IP_TOTAL_MAX=200
# RATE_LIMIT_LOGIN_IP_TOTAL_WINDOW_MS=900000 # 15 minutes
# RATE_LIMIT_LOGIN_IP_FAIL_MAX=20
# RATE_LIMIT_LOGIN_IP_FAIL_WINDOW_MS=900000  # 15 minutes
# LOCKOUT_PAIR_FAIL_MAX=5
# LOCKOUT_PAIR_WINDOW_MS=900000              # 15 minutes
# LOCKOUT_PAIR_DURATION_MS=900000            # 15 minutes
# LOCKOUT_EMAIL_FAIL_MAX=100
# LOCKOUT_EMAIL_WINDOW_MS=3600000            # 1 hour
# LOCKOUT_EMAIL_DURATION_MS=900000           # 15 minutes
# RATE_LIMIT_SIGNUP_MAX=10
# RATE_LIMIT_SIGNUP_WINDOW_MS=3600000        # 1 hour
# RATE_LIMIT_VERIFY_DOMAIN_MAX=20
# RATE_LIMIT_VERIFY_DOMAIN_WINDOW_MS=3600000 # 1 hour
# RATE_LIMIT_REGISTER_INSTITUTION_MAX=3
# RATE_LIMIT_REGISTER_INSTITUTION_WINDOW_MS=3600000 # 1 hour
# RATE_LIMIT_ADMIN_TENANT_MAX=30             # 30 mutating requests per 15 minutes per institution
# RATE_LIMIT_ADMIN_TENANT_WINDOW_MS=900000   # 15 minutes
# RATE_LIMIT_INTERNAL_AGENT_DISPATCH_MAX=60  # internal agent dispatch per IP per window
# RATE_LIMIT_INTERNAL_AGENT_DISPATCH_WINDOW_MS=900000  # 15 minutes

# M2 - shared secret for POST /api/m2/events/loan-lifecycle (M3 sends it as header x-internal-key). Min 16 chars.
M2_INTERNAL_KEY="replace-with-a-secure-random-secret-at-least-16-chars"
