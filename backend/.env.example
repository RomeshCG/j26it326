PORT=4000
NODE_ENV=development

# Central Neon database (institutions, users, routing)
CENTRAL_DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Default / demo tenant Neon database (business data for one MFI)
# Additional tenants are resolved at runtime via central.institution_databases
TENANT_DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Optional: used by seed scripts
DEMO_INSTITUTION_NAME="Apex Microfinance Ltd"
DEMO_INSTITUTION_LICENSE="MFI-DEMO-001"

# M3 — cross-module service URLs (leave unset to use stubs during local dev)
M1_SERVICE_URL=                # e.g. http://localhost:5001  — M1 risk scoring service
M2_SERVICE_URL=                # e.g. http://localhost:5002  — M2 ledger event webhook
M3_ML_SERVICE_URL=             # e.g. http://localhost:8000  — M3 EWS Python ML service
