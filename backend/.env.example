PORT=4000
NODE_ENV=development

# Central Neon database (institutions, users, routing)
CENTRAL_DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Default / demo tenant Neon database (business data for one MFI)
# Additional tenants are resolved at runtime via central.institution_databases
TENANT_DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Optional: used by seed scripts
DEMO_INSTITUTION_NAME="Apex Microfinance Ltd"
DEMO_INSTITUTION_LICENSE="MFI-DEMO-001"

# JWT Authentication (HS256)
# Minimum 32 characters, never use default/placeholder in real environments
JWT_SECRET="replace-with-a-secure-random-secret-at-least-32-chars-long"
JWT_EXPIRES_IN="15m"

# Tenant Routing & Pool configuration (optional, defaults shown)
# TENANT_DB_CONNECTION_LIMIT=5
# MAX_TENANT_CLIENTS=10
# ROUTING_CACHE_TTL_SECONDS=60
# USER_AUTH_CACHE_TTL_MS=5000
# ENABLE_SWAGGER_DOCS=false # In production: true enables /docs and /openapi.json (default is on in development)
