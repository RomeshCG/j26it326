{
  "name": "imfs-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "postinstall": "npm run prisma:generate",
    "prisma:generate": "npm run prisma:generate:central && npm run prisma:generate:tenant",
    "prisma:generate:central": "prisma generate --schema prisma/central/schema.prisma",
    "prisma:generate:tenant": "prisma generate --schema prisma/tenant/schema.prisma",
    "prisma:migrate:central": "prisma migrate dev --schema prisma/central/schema.prisma",
    "prisma:migrate:tenant": "prisma migrate dev --schema prisma/tenant/schema.prisma",
    "prisma:migrate:central:deploy": "prisma migrate deploy --schema prisma/central/schema.prisma",
    "prisma:migrate:tenant:deploy": "prisma migrate deploy --schema prisma/tenant/schema.prisma",
    "prisma:studio:central": "prisma studio --schema prisma/central/schema.prisma",
    "prisma:studio:tenant": "prisma studio --schema prisma/tenant/schema.prisma",
    "db:seed:central": "tsx prisma/central/seed.ts",
    "db:seed:tenant": "tsx prisma/tenant/seed.ts",
    "seed:zz-test-users": "tsx scripts/seed-zz-test-users.ts",
    "verify:a1-compliance": "tsx scripts/verify-a1-compliance.ts",
    "verify:a1-fixtures": "tsx scripts/verify-a1-fixtures.ts",
    "verify:a1-fixture-guards": "tsx scripts/verify-a1-fixture-guards.ts",
    "verify:a2-budget": "tsx scripts/verify-a2-budget-threshold.ts",
    "verify:a2-fixtures": "tsx scripts/verify-a2-fixtures.ts",
    "verify:a2-fixture-guards": "tsx scripts/verify-a2-fixture-guards.ts",
    "verify:a4-nlq": "tsx scripts/verify-a4-nlq.ts",
    "verify:zz-seed-safety": "tsx scripts/verify-zz-seed-safety.ts",
    "verify:safe-api-errors": "tsx scripts/verify-safe-api-errors.ts",
    "verify:graduated-trust": "tsx scripts/verify-graduated-trust.ts",
    "verify:offline-eval-runner": "tsx scripts/verify-offline-eval-runner.ts",
    "eval:offline": "tsx scripts/run-offline-eval.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^24.19.1",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^6.16.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
