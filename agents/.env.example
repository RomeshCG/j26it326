# IMFS Agents runtime (Phase 10) — copy to agents/.env for local use. Never commit real secrets.
# Requires Python 3.11+.

# Node backend base URL (no trailing slash required)
NODE_API_URL=http://localhost:4000

# Node internal dispatch shared secret (must match backend/.env AGENT_SERVICE_KEY).
# Min 32 chars; not a placeholder. Used only when calling Node — never as a public API key.
AGENT_SERVICE_KEY=replace-with-a-secure-random-secret-at-least-32-chars-long

# Caller auth for POST /v1/anomaly/dispatch-stub (separate from AGENT_SERVICE_KEY).
# Min 32 chars; not a placeholder. Required only when ENABLE_DISPATCH_STUB=true.
AGENTS_LOCAL_TOKEN=replace-with-a-secure-random-secret-at-least-32-chars-long

# Dispatch stub is OFF by default. Set true only for approved local E2E testing.
ENABLE_DISPATCH_STUB=false

# Isolation Forest artifacts directory (relative to agents/). Must contain
# a3-iforest-v2.joblib + a3-iforest-v2.meta.json. Scoring fails closed (503) if missing.
AGENTS_ARTIFACTS_DIR=artifacts

# Optional bind (documented in README; not read by the app — pass to uvicorn)
# AGENTS_HOST=127.0.0.1
# AGENTS_PORT=8001
